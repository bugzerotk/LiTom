#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <1>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <400>;
};

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&lt { quick-tap-ms = <300>; };

&mt { quick-tap-ms = <300>; };

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
            ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
            tap-ms = <20>;
        };

        mt_bl: mt_bl {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_BL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <300>;
        };

        lt_bl: lt_bl {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <300>;
        };

        td_lang2_alt_win: td_lang2_alt_win {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANG2_ALT_WIN";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT LANGUAGE_2>, <&kp LEFT_GUI>;
        };

        tl_tp: tl_tp {
            compatible = "zmk,behavior-hold-tap";
            label = "TL_TP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <300>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    keymap: combos {
        compatible = "zmk,combos";

        open-square-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <22 23>;
        };

        close-square-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <24 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE             &kp BACKSPACE
&lt_bl 2 Q             &kp W          &kp E              &kp R        &kp T                &mo 6  &mo 6            &kp Y      &kp U             &kp I         &kp O    &lt_bl 2 P
&tl_tp 4 A             &lt_bl 5 S     &kp D              &kp F        &kp G                &mo 6  &mo 6            &kp H      &kp J             &kp K         &kp L    &mo 4
&mt_bl LEFT_SHIFT Z    &kp X          &kp C              &kp V        &kp B                &none  &none            &kp N      &kp M             &kp COMMA     &kp DOT  &kp RIGHT_SHIFT
&mt LEFT_SHIFT ESCAPE  &kp LEFT_GUI   &td_lang2_alt_win  &lt 3 SPACE  &mt LCTRL BACKSPACE  &mo 1  &mt RCTRL ENTER  &lt 3 TAB  &lt 2 LANGUAGE_1  &lt 5 ESCAPE
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &mo 5   &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &mo 3   &trans  &trans  &trans  &mo 3   &trans    &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        SCROLL {
            bindings = <
&trans          &trans
&kp ESCAPE      &kp F2  &kp F3  &kp F4  &kp F5  &trans  &trans  &kp ESCAPE  &mkp MB3  &kp C_AC_BACK  &kp C_AC_FORWARD  &trans
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans      &mkp MB1  &mkp MB2       &mkp MB3          &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans         &trans            &kp RSHIFT
&trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        FUNCTION {
            bindings = <
&trans           &trans
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR  &kp PERCENT     &trans  &trans  &kp CARET      &kp AMPERSAND      &kp ASTERISK            &kp LEFT_PARENTHESIS        &kp RIGHT_PARENTHESIS
&none            &none        &kp GRAVE  &kp PLUS    &kp MINUS       &trans  &trans  &kp SEMICOLON  &kp SINGLE_QUOTE   &kp BACKSLASH           &kp PIPE                    &kp SLASH
&none            &none        &kp TILDE  &kp EQUAL   &kp UNDERSCORE  &trans  &trans  &kp COLON      &kp DOUBLE_QUOTES  &mt LEFT_GUI LESS_THAN  &mt RIGHT_ALT GREATER_THAN  &kp QUESTION
&trans           &trans       &trans     &trans      &trans          &trans  &trans  &trans         &trans             &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        NUM {
            bindings = <
&trans                &trans
&kp SLASH             &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS        &trans  &trans  &kp F10  &kp F7  &kp F8            &kp F9            &kp KP_NUMLOCK
&kp ASTERISK          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS         &trans  &trans  &kp F11  &kp F4  &kp F5            &kp F6            &none
&mt LEFT_SHIFT EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER        &trans  &trans  &kp F12  &kp F1  &mt F2 RIGHT_GUI  &mt F3 RIGHT_ALT  &kp RIGHT_SHIFT
&trans                &kp NUMBER_0  &kp NUMBER_0  &kp PERIOD    &mt RCTRL ENTER  &trans  &trans  &trans   &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        ARROW {
            bindings = <
&trans      &trans
&kp ESCAPE  &kp LS(INS)  &kp UP_ARROW    &kp PAGE_UP      &kp HOME          &oled_mode  &oled_mode  &kp INS         &kp SCROLLLOCK  &kp CAPSLOCK  &kp PRINTSCREEN  &kp RS(INS)
&kp LCTRL   &kp RCTRL    &kp LEFT        &kp RIGHT_ARROW  &kp TAB           &trans      &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp RCTRL
&kp LSHIFT  &kp INS      &kp DOWN_ARROW  &kp PAGE_DOWN    &kp END           &trans      &trans      &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp RIGHT_SHIFT
&trans      &trans       &trans          &kp LEFT_SHIFT   &mt LCTRL DELETE  &trans      &trans      &trans          &trans          &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        BT {
            bindings = <
&trans          &trans
&bt BT_CLR_ALL  &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &none           &trans  &none   &none   &none   &none   &none
&none           &none         &none         &none         &none         &none           &trans  &trans  &trans  &trans  &trans  &trans
&none           &none         &none         &none         &none         &none           &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &studio_unlock  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };
    };
};
